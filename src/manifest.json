{
  "manifest_version": 3,
  "name": "QueueTube",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "queuetube@issac.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "Turns YouTube into a single-player experience: one player tab, and every other video you open lines up in a queue.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background/index.js"
    ],
    "service_worker": "background/index.js"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "gather-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Gather open YouTube video tabs into the queue"
    },
    "next-video": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Play the next video in the queue"
    },
    "previous-video": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Play the previous video"
    },
    "toggle-queue": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Collapse or expand the queue panel"
    }
  }
}
