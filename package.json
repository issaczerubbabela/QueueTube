{
  "name": "queuetube",
  "version": "1.1.0",
  "description": "Transforms YouTube into a single-player experience with a persistent queue",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "dev": "node scripts/build.js",
    "test": "vitest run",
    "package": "npm run build && npx web-ext build -s dist -a builds --overwrite-dest",
    "package-source": "node scripts/source.js"
  },
  "dependencies": {
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.3.0",
    "archiver": "^8.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
}
